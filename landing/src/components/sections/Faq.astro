---
import { FAQ } from '../../consts';
---

<section class="seccion seccion--tenue" id="faq">
  <div class="envoltura">
    <div class="seccion__intro revela">
      <p class="kicker">Preguntas</p>
      <h2>{FAQ.titulo}</h2>
    </div>

    <div class="faq escalona">
      {
        FAQ.items.map((item, i) => (
          <details open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <i aria-hidden="true" />
            </summary>
            <div class="faq__cuerpo">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 76ch;
  }

  details {
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio-sm);
    margin-bottom: 0.6rem;
    transition: border-color var(--t-medio) var(--e-salida),
      box-shadow var(--t-medio) var(--e-salida);
  }

  details:hover {
    border-color: var(--linea-fuerte);
  }

  details[open] {
    border-color: var(--verde-100);
    box-shadow: var(--sombra-sm);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    padding: 1.1rem 1.25rem;
    min-height: 48px;
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: 1.04rem;
    letter-spacing: -0.015em;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Signo + que gira a × al abrir. */
  summary i {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
    transition: transform var(--t-medio) var(--e-salida);
  }

  summary i::before,
  summary i::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--verde);
    transform: translateY(-50%);
  }

  summary i::after {
    transform: translateY(-50%) rotate(90deg);
    transition: opacity var(--t-medio) var(--e-salida);
  }

  details[open] summary i {
    transform: rotate(135deg);
  }

  details[open] summary i::after {
    opacity: 0;
  }

  .faq__cuerpo {
    padding: 0 1.25rem 1.25rem;
  }

  .faq__cuerpo p {
    margin: 0;
    color: var(--tinta-70);
    max-width: var(--ancho-texto);
  }

  /* El contenido se despliega en lugar de saltar. `interpolate-size` permite
     animar hacia `auto` donde el navegador lo soporta; donde no, abre directo. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      :root {
        interpolate-size: allow-keywords;
      }

      details::details-content {
        block-size: 0;
        overflow: hidden;
        opacity: 0;
        transition: block-size var(--t-medio) var(--e-salida),
          opacity var(--t-medio) var(--e-salida), content-visibility var(--t-medio) allow-discrete;
      }

      details[open]::details-content {
        block-size: auto;
        opacity: 1;
      }
    }
  }
</style>
