---
import { CTA_FINAL, REGISTER_URL, LOGIN_URL } from '../../consts';
---

<section class="cierre" id="empezar">
  <div class="cierre__fondo" aria-hidden="true">
    <span class="halo"></span>
    <span class="lineas"></span>
  </div>

  <div class="envoltura cierre__caja revela">
    <h2>{CTA_FINAL.titulo}</h2>
    <p class="cierre__texto">{CTA_FINAL.texto}</p>
    <a class="boton boton--claro" href={REGISTER_URL}>{CTA_FINAL.cta}</a>
    <p class="cierre__nota">
      ¿Tu academia ya está dentro? <a href={LOGIN_URL}>Entra aquí</a>.
    </p>
  </div>
</section>

<style>
  .cierre {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(135deg, var(--verde) 0%, var(--verde-900) 100%);
    color: #fff;
    padding-block: clamp(4rem, 2rem + 7vw, 7rem);
  }

  .cierre__fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .halo {
    position: absolute;
    inset-block-start: -40%;
    inset-inline-start: 50%;
    translate: -50% 0;
    width: min(90vw, 760px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(123, 211, 137, 0.35), transparent 65%);
    filter: blur(50px);
  }

  .lineas {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 56px 100%;
    mask-image: linear-gradient(180deg, transparent, #000 40%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .halo {
      animation: respirar 17s ease-in-out infinite;
    }
  }

  .cierre__caja {
    text-align: center;
  }

  .cierre h2 {
    color: #fff;
  }

  .cierre__texto {
    max-width: 46ch;
    margin-inline: auto;
    margin-bottom: 2rem;
    color: #d6ebe0;
    font-size: 1.1rem;
  }

  .cierre__nota {
    margin: 1.4rem 0 0;
    font-size: 0.95rem;
    color: #d7e9df;
  }

  .cierre__nota a {
    color: #fff;
  }
</style>
