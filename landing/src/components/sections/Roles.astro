---
import { ROLES } from '../../consts';
import Shot from '../Shot.astro';
---

<section class="seccion seccion--tenue" id="roles">
  <div class="envoltura">
    <div class="seccion__intro revela">
      <p class="kicker">Quién lo usa</p>
      <h2>{ROLES.titulo}</h2>
      <p>{ROLES.entrada}</p>
    </div>

    <ul class="roles escalona">
      {
        ROLES.items.map((r) => (
          <li class="rol">
            <div class="rol__marco">
              <Shot src={r.captura} alt={r.alt} />
            </div>
            <div class="rol__texto">
              <h3>{r.rol}</h3>
              <p>{r.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .roles {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  }

  .rol {
    display: flex;
    flex-direction: column;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    overflow: hidden;
    transition: transform var(--t-medio) var(--e-salida),
      box-shadow var(--t-medio) var(--e-salida), border-color var(--t-medio) var(--e-salida);
  }

  .rol:hover {
    transform: translateY(-4px);
    box-shadow: var(--sombra);
    border-color: var(--linea-fuerte);
  }

  /* Las capturas de rol tienen alturas distintas: se igualan para que los
     textos de las cuatro tarjetas arranquen a la misma altura. */
  .rol__marco :global(.captura) {
    border: 0;
    border-radius: 0;
    border-bottom: 1px solid var(--linea);
    box-shadow: none;
  }

  .rol__marco :global(.captura img) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .rol__texto {
    padding: 1.4rem 1.5rem 1.6rem;
  }

  .rol h3 {
    margin-bottom: 0.35rem;
  }

  .rol p {
    margin: 0;
    color: var(--tinta-70);
    font-size: 1rem;
  }
</style>
