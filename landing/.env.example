# URL pública del panel web (Vite + Mantine). Todos los CTA apuntan a
# ${PUBLIC_APP_URL}/register y el enlace de "Ya tengo cuenta" a /login.
PUBLIC_APP_URL=https://app.futcademic.com

# URL canónica de este sitio. La usa el sitemap y las etiquetas og:url.
PUBLIC_SITE_URL=https://futcademic.com

# Opcional: URL del aviso de privacidad. Mientras esté vacía, el footer
# no muestra el enlace en lugar de apuntar a una página inexistente.
PUBLIC_PRIVACY_URL=
